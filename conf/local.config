/*
 * Local executor config
 * Adjust `executor.cpus` / `executor.memory` to match your machine.
 * All process dependencies come from environment.yml (see conda.enabled
 * in nextflow.config) — Nextflow builds/caches the conda env automatically.
 */

executor {
    name   = 'local'
    cpus   = 8
    memory = '32 GB'
}

process {
    executor = 'local'
    conda    = "${projectDir}/environment.yml"
    cpus     = 4
    memory   = '8 GB'
    time     = '4h'
}
