/*
 * Nextflow configuration — UTR Translation Efficiency Pipeline V5
 * Runs anywhere with Nextflow + conda — no cluster scheduler or
 * environment modules required.
 */

manifest {
    name        = 'UTR-Translation-Efficiency'
    version     = '5.0'
    description = 'Cell-type specific UTR translational efficiency via C→T editing'
    author      = 'Yeo Lab'
}

// ─── Global defaults ──────────────────────────────────────────────────────────
params {
    help = false
}

// ─── Conda ────────────────────────────────────────────────────────────────────
// All tools (STAR, samtools, cutadapt, fastqc, multiqc, Python stack) come from
// environment.yml. Nextflow creates/caches the env automatically per process —
// no manual `conda activate` or `module load` needed.
conda.enabled = true

// ─── Profiles ────────────────────────────────────────────────────────────────
profiles {

    // ── Local execution (default) ─────────────────────────────────────────────
    standard {
        includeConfig 'conf/local.config'
    }
}

// ─── Trace / report ───────────────────────────────────────────────────────────
trace {
    enabled   = true
    file      = "${params.outdir}/logs/pipeline_trace.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,cpus,memory,disk'
}

report {
    enabled   = true
    file      = "${params.outdir}/logs/pipeline_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/logs/pipeline_timeline.html"
    overwrite = true
}
